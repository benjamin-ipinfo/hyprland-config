// MacBook Pro 14"/16" with appledrm.show_notch=1: the bar fills the strip beside the
// notch (74 px = 37 logical px at scale 2), like the macOS menu bar. Workspaces move
// to the left because the centre is hidden behind the notch.
// Everything else comes from config.jsonc (values here take precedence).
{
    "include": ["~/.config/waybar/config.jsonc"],
    "height": 37,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": []
}
